{
  "name": "@alexanderfortin/pi-token-usage",
  "author": "Alexander Fortin",
  "version": "0.4.0",
  "description": "Pi coding agent extension for analyzing token usage and cost across session files",
  "keywords": [
    "pi-package",
    "token-usage",
    "cost-tracking",
    "session-analysis"
  ],
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@sinclair/typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shaftoe/pi-token-usage"
  },
  "scripts": {
    "build": "pnpm run check && tsc --project tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "eslint ./",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov",
    "validate": "pnpm run check && pnpm run lint && pnpm run format:check",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@alexanderfortin/semantic-release-keep-a-changelog": "^0.4.14",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "typescript": "6",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  }
}
